
# Online Leaderboard Ranking using Heap Sort

def heapify(arr, n, i, heap_type):
    root = i
    left = 2 * i + 1
    right = 2 * i + 2

    if heap_type == "max":
        if left < n and arr[left] > arr[root]:
            root = left
        if right < n and arr[right] > arr[root]:
            root = right
    else:
        if left < n and arr[left] < arr[root]:
            root = left
        if right < n and arr[right] < arr[root]:
            root = right

    if root != i:
        arr[i], arr[root] = arr[root], arr[i]
        heapify(arr, n, root, heap_type)


def heap_sort(arr, heap_type):
    n = len(arr)

    # Build Heap
    for i in range(n // 2 - 1, -1, -1):
        heapify(arr, n, i, heap_type)

    # Sort elements
    for i in range(n - 1, 0, -1):
        arr[0], arr[i] = arr[i], arr[0]
        heapify(arr, i, 0, heap_type)

    return arr


# Player scores
scores = [85, 45, 95, 60, 75, 90]

print("Player Scores:", scores)

# Max Heap - Ascending Order
max_scores = scores.copy()
heap_sort(max_scores, "max")
print("Ascending Order (Max Heap):", max_scores)

# Min Heap - Descending Order
min_scores = scores.copy()
heap_sort(min_scores, "min")
print("Descending Order (Min Heap):", min_scores)
