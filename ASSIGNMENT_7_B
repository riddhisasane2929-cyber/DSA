
class Graph:
    def __init__(self, vertices):
        self.vertices = vertices
        self.matrix = [[0] * vertices for i in range(vertices)]

    # Add road between intersections
    def add_edge(self, u, v):
        self.matrix[u][v] = 1
        self.matrix[v][u] = 1

    # Display adjacency matrix
    def display(self):
        print("Adjacency Matrix:")
        for row in self.matrix:
            print(row)

    # DFS Traversal
    def dfs(self, start):
        visited = [False] * self.vertices
        stack = [start]

        print("DFS Traversal:")

        while stack:
            vertex = stack.pop()

            if not visited[vertex]:
                print(vertex, end=" ")
                visited[vertex] = True

                for i in range(self.vertices - 1, -1, -1):
                    if self.matrix[vertex][i] == 1 and not visited[i]:
                        stack.append(i)


# Main Program
g = Graph(5)

# Adding roads
g.add_edge(0, 1)
g.add_edge(0, 2)
g.add_edge(1, 3)
g.add_edge(1, 4)
g.add_edge(2, 4)

# Display graph
g.display()

# Perform DFS
g.dfs(0)
