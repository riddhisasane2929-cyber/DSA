
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class SinglyLinkedList:
    def __init__(self):
        self.head = None

    # Insert at beginning
    def insert_beginning(self, book_id):
        new_node = Node(book_id)
        new_node.next = self.head
        self.head = new_node
        print(book_id, "inserted at beginning")

    # Insert at end
    def insert_end(self, book_id):
        new_node = Node(book_id)

        if self.head is None:
            self.head = new_node
            return

        temp = self.head
        while temp.next:
            temp = temp.next

        temp.next = new_node
        print(book_id, "inserted at end")

    # Delete from beginning
    def delete_beginning(self):
        if self.head is None:
            print("List is Empty")
        else:
            print("Deleted book ID:", self.head.data)
            self.head = self.head.next

    # Display linked list
    def display(self):
        if self.head is None:
            print("List is Empty")
            return

        temp = self.head
        print("Book IDs:", end=" ")

        while temp:
            print(temp.data, end=" -> ")
            temp = temp.next

        print("None")


# Main program
ll = SinglyLinkedList()

ll.insert_beginning(101)
ll.insert_beginning(102)
ll.insert_end(103)

ll.display()

ll.delete_beginning()

ll.display()
