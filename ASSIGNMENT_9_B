
# Power Distribution Network Optimization
# Using Kruskal's Algorithm

class Graph:
    def __init__(self, vertices):
        self.V = vertices
        self.edges = []

    def add_edge(self, u, v, cost):
        self.edges.append([cost, u, v])

    def find(self, parent, i):
        if parent[i] != i:
            parent[i] = self.find(parent, parent[i])
        return parent[i]

    def union(self, parent, rank, x, y):
        xroot = self.find(parent, x)
        yroot = self.find(parent, y)

        if rank[xroot] < rank[yroot]:
            parent[xroot] = yroot
        elif rank[xroot] > rank[yroot]:
            parent[yroot] = xroot
        else:
            parent[yroot] = xroot
            rank[xroot] += 1

    def kruskal(self):
        result = []
        self.edges.sort()

        parent = list(range(self.V))
        rank = [0] * self.V

        total_cost = 0

        for cost, u, v in self.edges:
            x = self.find(parent, u)
            y = self.find(parent, v)

            if x != y:
                result.append((u, v, cost))
                total_cost += cost
                self.union(parent, rank, x, y)

        print("Minimum Spanning Tree:")
        for u, v, cost in result:
            print(f"Substation {u} - Substation {v}: Cost = {cost}")

        print("Total Minimum Wiring Cost:", total_cost)


# Create graph
g = Graph(5)

# Add connections (u, v, cost)
g.add_edge(0, 1, 10)
g.add_edge(0, 2, 20)
g.add_edge(1, 2, 15)
g.add_edge(1, 3, 25)
g.add_edge(2, 3, 30)
g.add_edge(2, 4, 40)
g.add_edge(3, 4, 35)

# Generate MST
g.kruskal()
